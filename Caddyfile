{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static private_ranges
	}
	log {
		output stdout
		level WARN
	}
}

:{$PORT:8080} {
	# Open health path for Railway: answers only when PiClaw itself answers.
	handle /healthz {
		rewrite * /manifest.json
		reverse_proxy 127.0.0.1:8081
	}

	# Everything else (web UI, API, terminal websockets) needs the generated login.
	handle {
		basic_auth {
			{$PICLAW_USERNAME} {$PICLAW_PASSWORD_HASH}
		}
		reverse_proxy 127.0.0.1:8081
	}
}
